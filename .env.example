# ============================================================
#  WhatsApp Suite — environment configuration
#  Self-hosted on cPanel. No external database or hosting service.
# ============================================================

# SQLite database file location (created automatically on first run).
# Leave default unless you want it elsewhere on your cPanel disk.
DATABASE_PATH=server/data/app.db

# JWT signing secret (REQUIRED).
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Encryption key for WhatsApp tokens at rest (REQUIRED — exactly 64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key

# Server
PORT=3000
NODE_ENV=production
BASE_URL=https://your-domain.acquihiretech.com

# Email (SMTP) — use your cPanel email account or any SMTP provider
SMTP_HOST=mail.acquihiretech.com
SMTP_PORT=587
SMTP_USER=noreply@acquihiretech.com
SMTP_PASS=your-email-password
FROM_EMAIL=noreply@acquihiretech.com
FROM_NAME=WhatsApp Suite by AcquiHire Tech

# WhatsApp OTP (Meta Cloud API) — optional; leave blank to use email-only verification
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_OTP_TEMPLATE=otp_verification

# WhatsApp delivery receipts webhook (recommended once you send broadcasts).
# Set any random string here, then enter the SAME string as "Verify token" in
# Meta App Dashboard -> WhatsApp -> Configuration, with callback URL:
#   https://your-domain/api/webhooks/whatsapp
WA_WEBHOOK_VERIFY_TOKEN=
# Optional extra security: your Meta App Secret (verifies webhook signatures).
WA_APP_SECRET=

# Limits
MAX_WHATSAPP_ACCOUNTS=25
MAX_AVATAR_SIZE_MB=5
OTP_EXPIRY_MINUTES=10
