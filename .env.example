# ============================================================
#  WhatsApp Suite — environment configuration
#  Self-hosted on cPanel. No external database or hosting service.
# ============================================================

# SQLite database file location (created automatically on first run).
#
# IMPORTANT: this path MUST be outside the application folder. Anything inside
# it risks being published by the web server, and the database holds password
# hashes, contact details and your WhatsApp access tokens. Note that WAL mode
# keeps live rows in app.db-wal, so the sibling -wal and -shm files matter too.
# An absolute path in your home directory, next to (not inside) the app, is best.
DATABASE_PATH=/home/YOUR-CPANEL-USER/whatsapp-suite-data/app.db

# JWT signing secret (REQUIRED).
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Encryption key for WhatsApp tokens at rest (REQUIRED — exactly 64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key

# Server
PORT=3000
# Anything other than exactly "development" or "test" is treated as production,
# so a typo here keeps the protections ON rather than silently disabling them.
NODE_ENV=production

# How long a password reset link stays valid, in minutes.
PASSWORD_RESET_EXPIRY_MINUTES=30
BASE_URL=https://your-domain.acquihiretech.com

# Email (SMTP) — use your cPanel email account or any SMTP provider
SMTP_HOST=mail.acquihiretech.com
SMTP_PORT=587
SMTP_USER=noreply@acquihiretech.com
SMTP_PASS=your-email-password
FROM_EMAIL=noreply@acquihiretech.com
FROM_NAME=WhatsApp Suite by AcquiHire Tech

# Graph API version used for all Meta calls.
# Meta supports each version for about two years, then it stops working.
# Check https://developers.facebook.com/docs/graph-api/changelog and bump this
# well before your version's sunset date — no code change is needed.
WA_GRAPH_VERSION=v23.0

# Graph API host. Leave blank in production. Set it only to point at Meta's
# sandbox, an outbound proxy, or a local stub while testing.
WA_GRAPH_BASE_URL=

# WhatsApp OTP (Meta Cloud API) — optional; leave blank to use email-only verification
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_OTP_TEMPLATE=otp_verification

# WhatsApp delivery receipts webhook (recommended once you send broadcasts).
# Set any random string here, then enter the SAME string as "Verify token" in
# Meta App Dashboard -> WhatsApp -> Configuration, with callback URL:
#   https://your-domain/api/webhooks/whatsapp
WA_WEBHOOK_VERIFY_TOKEN=
# REQUIRED in production: your Meta App Secret, from
# Meta App Dashboard -> Settings -> Basic -> App Secret.
# The webhook URL is not a secret, so this signature check is the only thing
# proving a call really came from Meta. Without it, anyone who knows the URL can
# forge inbound messages, opt-outs, delivery receipts and quality-rating updates.
# The app refuses to start in production if this is missing.
WA_APP_SECRET=

# Opt-out / opt-in keywords. An inbound message matching one of these exactly
# (case-insensitive) unsubscribes or resubscribes the contact. WhatsApp requires
# opt-out requests to be honoured — extend these for the languages you serve.
# Defaults: stop,unsubscribe,unsub,cancel,end,quit,optout / start,subscribe,unstop,resume
WA_OPT_OUT_KEYWORDS=
WA_OPT_IN_KEYWORDS=

# Limits
MAX_WHATSAPP_ACCOUNTS=25
MAX_AVATAR_SIZE_MB=5
OTP_EXPIRY_MINUTES=10
